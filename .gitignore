# ---------------------------------------------------------------------------
# Rust / Tauri
# ---------------------------------------------------------------------------
/target/
app/src-tauri/target/
app/src-tauri/gen/
app/src-tauri/Cargo.lock

# JS dependencies (Tauri CLI)
node_modules/
package-lock.json

# Web content staged for the build (copied from contents/ by
# scripts/prepare-web.ps1, regenerated on every build)
app/web/*
!app/web/.gitkeep

# Icons generated from the content logo (scripts/generate-icons.ps1)
app/src-tauri/icons/

# ---------------------------------------------------------------------------
# Local artifacts / scratch files
# ---------------------------------------------------------------------------
artifacts/
certs/
*.log
*.user
.DS_Store
Thumbs.db
