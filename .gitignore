app/web/*
!app/web/.gitkeep

# Icônes générées depuis le logo du contenu (scripts/generate-icons.ps1)
app/src-tauri/icons/

# ---------------------------------------------------------------------------
# Artefacts locaux / brouillons
# ---------------------------------------------------------------------------
artifacts/
certs/
*.log
*.user
.DS_Store
Thumbs.db
