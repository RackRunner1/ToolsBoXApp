{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToolsBoXApp",
  "version": "2026.1.1",
  "identifier": "com.rackrunner.toolsboxapp",
  "build": {
    "frontendDist": "../web",
    "removeUnusedCommands": false
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ToolsBoXApp",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; frame-src 'self'; object-src 'none'; base-uri 'self'",
      "freezePrototype": false,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "publisher": "RackRunner",
    "copyright": "Copyright © RackRunner",
    "homepage": "https://github.com/RackRunner1/ToolsBoXApp",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Desktop toolbox (ToolsBoXMachine content)",
    "longDescription": "ToolsBoXApp embeds the ToolsBoXMachine content in a WebView2 window and notifies about new versions published on GitHub.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "compression": "lzma"
      }
    },
    "resources": []
  }
}
