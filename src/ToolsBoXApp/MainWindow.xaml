<Window x:Class="ToolsBoXApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ToolsBoX"
        Height="880" Width="1280" MinHeight="600" MinWidth="960"
        Icon="toolbox.ico"
        Background="#0f172a">

    <DockPanel>

        <!-- ======== Barre d'outils ======== -->
        <Border DockPanel.Dock="Top" Background="#1e293b" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnBack" Grid.Column="0" Content="◀" ToolTip="Précédent (Alt+←)"
                        Width="36" Height="32" Margin="0,0,4,0" Click="BtnBack_Click" />
                <Button x:Name="BtnForward" Grid.Column="1" Content="▶" ToolTip="Suivant (Alt+→)"
                        Width="36" Height="32" Margin="0,0,4,0" Click="BtnForward_Click" />
                <Button x:Name="BtnReload" Grid.Column="2" Content="⟳" ToolTip="Recharger (F5)"
                        Width="36" Height="32" Margin="0,0,4,0" Click="BtnReload_Click" />
                <Button x:Name="BtnHome" Grid.Column="3" Content="🏠" ToolTip="Accueil du site"
                        Width="40" Height="32" Margin="0,0,10,0" Click="BtnHome_Click" />

                <Border Grid.Column="4" Background="#0f172a" CornerRadius="6" Padding="10,5"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="TxtAddress" Text="contents\" Foreground="#94a3b8" FontFamily="Consolas" />
                </Border>

                <Button x:Name="BtnOpenFolder" Grid.Column="6" Content="📂" ToolTip="Ouvrir contents\ dans l'Explorateur"
                        Width="40" Height="32" HorizontalAlignment="Right" Click="BtnOpenFolder_Click" />
            </Grid>
        </Border>

        <!-- ======== Barre d'état ======== -->
        <StatusBar DockPanel.Dock="Bottom" Background="#1e293b" Foreground="#94a3b8" Height="28">
            <TextBlock x:Name="TxtStatus" Margin="8,0" Text="Chargement…" />
        </StatusBar>

        <!-- ======== Panneau principal ======== -->
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="180" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ---- Explorateur contents/ ---- -->
            <DockPanel Grid.Column="0" Background="#0f172a">
                <Border DockPanel.Dock="Top" Background="#1e293b" Padding="12,8">
                    <TextBlock Text="Contenus" Foreground="#e2e8f0" FontWeight="SemiBold" />
                </Border>
                <TreeView x:Name="ContentTree"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="#e2e8f0"
                          SelectedItemChanged="ContentTree_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Display}"
                                       Foreground="{Binding Foreground}"
                                       Padding="0,2" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#334155" />

            <!-- ---- Navigateur (moteur de rendu du site) ---- -->
            <Grid Margin="4,0,0,0" Grid.Column="1">
                <wpf:WebView2 x:Name="Browser" Visibility="Hidden" />
                <TextBlock x:Name="Placeholder"
                           Text="Chargement du contenu…"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           MaxWidth="420"
                           Foreground="#64748b"
                           FontSize="14"
                           LineHeight="24" />
            </Grid>

        </Grid>
    </Grid>
</Window>
